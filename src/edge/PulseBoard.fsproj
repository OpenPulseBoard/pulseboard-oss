<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>PulseBoard</AssemblyName>
    <RootNamespace>PulseBoard</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TimeSeries.fs" />
    <Compile Include="Hub.fs" />
    <Compile Include="Alerts.fs" />
    <Compile Include="Segments.fs" />
    <Compile Include="Tenancy.fs" />
    <Compile Include="Secrets.fs" />
    <Compile Include="PgSecretsStore.fs" />
    <Compile Include="Audit.fs" />
    <Compile Include="Quotas.fs" />
    <Compile Include="Plans.fs" />
    <Compile Include="Billing.fs" />
    <Compile Include="PgBillingStore.fs" />
    <Compile Include="Pricing.fs" />
    <Compile Include="Costs.fs" />
    <Compile Include="AiAssist.fs" />
    <Compile Include="PgTenantStore.fs" />
    <Compile Include="PgQuotaOverrides.fs" />
    <Compile Include="PgAuditLog.fs" />
    <Compile Include="S3AuditExporter.fs" />
    <Compile Include="Rbac.fs" />
    <Compile Include="Session.fs" />
    <Compile Include="Oidc.fs" />
    <Compile Include="Auth.fs" />
    <Compile Include="Notify.fs" />
    <Compile Include="Storage.fs" />
    <Compile Include="CloudBackends.fs" />
    <Compile Include="S3SegmentBackend.fs" />
    <Compile Include="Retention.fs" />
    <Compile Include="PgRetentionOverrides.fs" />
    <Compile Include="Gateway.fs" />
    <Compile Include="HeartbeatClient.fs" />
    <Compile Include="Ingest.fs" />
    <Compile Include="PromRemoteWrite.fs" />
    <Compile Include="Spans.fs" />
    <Compile Include="Otlp.fs" />
    <Compile Include="LokiPush.fs" />
    <Compile Include="PromScrape.fs" />
    <Compile Include="Listeners.fs" />
    <Compile Include="Rollups.fs" />
    <Compile Include="Query.fs" />
    <Compile Include="QueryApi.fs" />
    <Compile Include="NotifyQueue.fs" />
    <Compile Include="PgNotifyQueue.fs" />
    <Compile Include="Rules.fs" />
    <Compile Include="PgRulesStore.fs" />
    <Compile Include="Runbooks.fs" />
    <Compile Include="PgRunbookStore.fs" />
    <Compile Include="Correlation.fs" />
    <Compile Include="Synthetics.fs" />
    <Compile Include="PgSyntheticStore.fs" />
    <Compile Include="StatusPages.fs" />
    <Compile Include="PgStatusStore.fs" />
    <Compile Include="Routing.fs" />
    <Compile Include="PgRoutingStore.fs" />
    <Compile Include="OnCall.fs" />
    <Compile Include="PgOnCallStore.fs" />
    <Compile Include="Dashboards.fs" />
    <Compile Include="PgDashboardRepo.fs" />
    <Compile Include="GitSync.fs" />
    <Compile Include="ExportCode.fs" />
    <Compile Include="Self.fs" />
    <Compile Include="TraceApi.fs" />
    <Compile Include="Rum.fs" />
    <Compile Include="Admin.fs" />
    <Compile Include="AgentApi.fs" />
    <Compile Include="PgAgentStore.fs" />
    <Compile Include="Signup.fs" />
    <Compile Include="Program.fs" />
    <None Include="wwwroot/index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot/app.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot/app.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot/admin.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot/live.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot/docs.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot/home.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot/workspace.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot/pricing.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot/operator-signin.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot/status.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot/uPlot.iife.min.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot/uPlot.min.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Brand assets: full wordmark (dark- and light-bg variants) plus
         icon-only favicon. Served as static files from wwwroot/. -->
    <None Include="wwwroot/favicon.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot/pulse-board-logo.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot/pulse-board-logo-dark.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.23.3" />
    <PackageReference Include="Google.Protobuf" Version="3.35.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.18.0" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="Suave" Version="3.4.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.18.0" />
  </ItemGroup>
</Project>
