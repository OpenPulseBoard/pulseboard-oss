# PulseBoard front Caddyfile
#
# Sits in front of:
#   * the apex pulseboard.cloud (the --site-only marketing host)
#   * every <slug>.pulseboard.cloud (per-customer workspace on Fly)
#
# Caddy mints certificates on demand. Before issuing for a hostname it
# asks our provisioner whether that slug is known (`/provision/ask`),
# so attackers can't make Caddy hammer Let's Encrypt for random
# subdomains. Once a cert is issued, the request is reverse-proxied to
# whatever upstream the provisioner returns (`/provision/route`).
#
# Environment expected:
#   PROVISIONER_URL  internal URL of the provisioner (e.g. http://provisioner.flycast:8080)
#   SITE_URL         internal URL of the --site-only marketing instance
#
# Drop this in /etc/caddy/Caddyfile and `caddy reload`.

{
	# On-demand TLS — Caddy will ask before minting any cert.
	on_demand_tls {
		ask {$PROVISIONER_URL}/provision/ask
	}
	# Tune ACME contacts so Let's Encrypt has a recovery address.
	email ops@pulseboard.cloud
}

# Apex — the marketing site.
pulseboard.cloud, www.pulseboard.cloud {
	encode zstd gzip
	reverse_proxy {$SITE_URL} {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# Every workspace subdomain — upstream is derived from the slug.
#
# Workspace apps are deterministically named `pb-<slug>` and reachable on
# Fly's private DNS at `pb-<slug>.flycast:8080`. So for
# `foo.pulseboard.cloud` the upstream is `pb-foo.flycast:8080`, computed
# via Caddy's {labels.N} placeholder (labels are right-to-left:
# labels.0=cloud, labels.1=pulseboard, labels.2=<slug>). This avoids
# pulling in the third-party `dynamic http` upstreams module — stock
# Caddy only ships `srv`, `a`, and `multi` providers.
#
# We use `.flycast` (not `.internal`) so workspaces auto-start on the
# first request after they've been stopped for idle, and so Fly's proxy
# applies the app's concurrency limits & health checks. `.internal`
# would dial the VM directly and fail with connection-refused on any
# stopped machine.
#
# On-demand TLS still calls /provision/ask before minting a cert, so an
# attacker can't trick Caddy into hammering Let's Encrypt for random
# subdomains. If a workspace is deprovisioned later, requests reaching
# this block will simply 502 (DNS NXDOMAIN at proxy time).
*.pulseboard.cloud {
	tls {
		on_demand
	}
	encode zstd gzip

	# Caddy refuses placeholders in an upstream that includes a scheme,
	# so we drop the `http://` prefix (plain HTTP is the default transport).
	reverse_proxy pb-{labels.2}.flycast:8080 {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		# WebSocket upgrade headers pass through automatically.
	}
}
