# PulseBoard front Caddyfile
#
# Sits in front of:
#   * the apex pulseboard.cloud (the --site-only marketing host)
#   * every <slug>.pulseboard.cloud (per-customer workspace on Fly)
#
# Caddy mints certificates on demand. Before issuing for a hostname it
# asks our provisioner whether that slug is known (`/provision/ask`),
# so attackers can't make Caddy hammer Let's Encrypt for random
# subdomains. Once a cert is issued, the request is reverse-proxied to
# whatever upstream the provisioner returns (`/provision/route`).
#
# Environment expected:
#   PROVISIONER_URL  internal URL of the provisioner (e.g. http://provisioner.flycast)
#   SITE_URL         internal URL of the --site-only marketing instance
#
# Drop this in /etc/caddy/Caddyfile and `caddy reload`.

{
	# On-demand TLS — Caddy will ask before minting any cert.
	on_demand_tls {
		ask {$PROVISIONER_URL}/provision/ask
	}
	# Tune ACME contacts so Let's Encrypt has a recovery address.
	email ops@pulseboard.cloud
}

# Apex — the marketing site.
pulseboard.cloud, www.pulseboard.cloud {
	encode zstd gzip
	reverse_proxy {$SITE_URL} {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# Admin portal — a named host (NOT under the wildcard) so Caddy's
# specificity-based matcher always picks this block over the
# `*.pulseboard.cloud` wildcard below.
#
# We use `tls { on_demand }` here (same as the wildcard) so the cert
# is issued lazily on the first real request rather than eagerly at
# Caddy startup. Eager issuance fails whenever Caddy boots before the
# admin DNS record propagates, or before port 80 is reachable for the
# HTTP-01 challenge — and the failure surfaces in browsers as
# ERR_SSL_PROTOCOL_ERROR with a `tcp-backhaul: unexpected end of file`
# in the Fly proxy log because Caddy aborts the TLS handshake when it
# has no cert. On-demand issuance retries on every request and the
# provisioner's `/provision/ask` whitelists `admin.<rootDomain>` so
# attackers still can't trick Caddy into hammering Let's Encrypt.
#
# `OIDC_REDIRECT_URI` on the provisioner must point at
# https://admin.pulseboard.cloud/admin/callback so the IdP returns the
# browser to this hostname.
admin.pulseboard.cloud {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy {$PROVISIONER_URL} {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# Every workspace subdomain — upstream is derived from the slug.
#
# Workspace apps are deterministically named `pb-<slug>` and reachable
# over Fly's private flycast network at `pb-<slug>.flycast` (port 80).
# So for `foo.pulseboard.cloud` the upstream is `pb-foo.flycast`,
# computed via Caddy's {labels.N} placeholder (labels are right-to-
# left: labels.0=cloud, labels.1=pulseboard, labels.2=<slug>). This
# avoids pulling in the third-party `dynamic http` upstreams module —
# stock Caddy only ships `srv`, `a`, and `multi` providers.
#
# We use `.flycast` (not `.internal`) so workspaces auto-start on the
# first request after they've been stopped for idle, and so Fly's proxy
# applies the app's concurrency limits & health checks. `.internal`
# would dial the VM directly and fail with connection-refused on any
# stopped machine.
#
# Important: the Fly proxy on a flycast address listens on the public
# port declared by [http_service] (port 80 for plain HTTP), NOT on
# `internal_port`. internal_port=8080 is only the port the proxy then
# forwards to *inside* the VM. Connecting to `pb-foo.flycast:8080`
# hits a port the proxy isn't bound to and gets RST'd; the right
# upstream is `pb-foo.flycast` (default :80).
#
# On-demand TLS still calls /provision/ask before minting a cert, so an
# attacker can't trick Caddy into hammering Let's Encrypt for random
# subdomains. If a workspace is deprovisioned later, requests reaching
# this block will simply 502 (DNS NXDOMAIN at proxy time).
*.pulseboard.cloud {
	tls {
		on_demand
	}
	encode zstd gzip

	# Caddy refuses placeholders in an upstream that includes a scheme,
	# so we drop the `http://` prefix (plain HTTP is the default
	# transport). No `:port` either — flycast's proxy is on :80.
	reverse_proxy pb-{labels.2}.flycast:80 {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		# WebSocket upgrade headers pass through automatically.
	}
}
