<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ShadowCopyFiles>true</ShadowCopyFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test infrastructure -->
    <Compile Include="Helpers/TestEdge.fs" />
    <Compile Include="Helpers/TestPostgres.fs" />
    <!-- Unit tests -->
    <Compile Include="Unit/RollupsTests.fs" />
    <Compile Include="Unit/QueryApiTests.fs" />
    <Compile Include="Unit/QuotasTests.fs" />
    <Compile Include="Unit/SecretsTests.fs" />
    <Compile Include="Unit/AiAssistTests.fs" />
    <Compile Include="Unit/RulesTests.fs" />
    <Compile Include="Unit/RunbooksTests.fs" />
    <Compile Include="Unit/RoutingTests.fs" />    <Compile Include="Unit/NotifyQueueTests.fs" />
    <Compile Include="Unit/OnCallTests.fs" />
    <Compile Include="Unit/RetentionTests.fs" />
    <Compile Include="Unit/PlansTests.fs" />
    <Compile Include="Unit/SpansTests.fs" />
    <Compile Include="Unit/TenancyTests.fs" />
    <Compile Include="Unit/SyntheticsTests.fs" />
    <Compile Include="Unit/AgentGroupsTests.fs" />
    <Compile Include="Unit/CardinalityKillerTests.fs" />
    <Compile Include="Unit/BillPredictorTests.fs" />
    <Compile Include="Unit/StatusPagesTests.fs" />
    <Compile Include="Unit/GitSyncTests.fs" />
    <Compile Include="Unit/ExportCodeTests.fs" />
    <!-- Property-based tests -->
    <Compile Include="Properties/RollupsPropertyTests.fs" />
    <Compile Include="Properties/RulesPropertyTests.fs" />
    <Compile Include="Properties/RoutingPropertyTests.fs" />
    <Compile Include="Properties/PlansPropertyTests.fs" />
    <Compile Include="Properties/SpansPropertyTests.fs" />
    <Compile Include="Properties/TenancyPropertyTests.fs" />
    <!-- Integration tests (Category=Postgres requires Docker; Category=Integration runs in-process) -->
    <Compile Include="Integration/PgTenantStoreTests.fs" />
    <Compile Include="Integration/PgAuditLogTests.fs" />
    <Compile Include="Integration/PgOverridesTests.fs" />
    <Compile Include="Integration/PgRunbookStoreTests.fs" />
    <Compile Include="Integration/HttpApiTests.fs" />
    <!-- Phase 11.5 acceptance scenarios -->
    <Compile Include="Integration/AuthIsolationTests.fs" />
    <Compile Include="Integration/ProtocolIngestTests.fs" />
    <Compile Include="Integration/RoutingFlapTests.fs" />
    <Compile Include="Integration/RoutingLateSilenceTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core test SDK — required for 'dotnet test' discovery -->
    <PackageReference Include="Microsoft.NET.Test.Sdk"         Version="17.13.0" />
    <!-- xUnit v2 test framework -->
    <PackageReference Include="xunit"                          Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio"      Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- F# assertion helpers -->
    <PackageReference Include="FsUnit.xUnit"                   Version="5.0.1" />
    <!-- Property-based testing -->
    <PackageReference Include="FsCheck.Xunit"                  Version="2.16.6" />
    <!-- Code coverage -->
    <PackageReference Include="coverlet.collector"             Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Postgres container for integration tests -->
    <PackageReference Include="Testcontainers.PostgreSql"      Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/edge/PulseBoard.fsproj" />
  </ItemGroup>
</Project>
