<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- BenchmarkDotNet requires Release for meaningful results -->
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageReference Include="Snappier"        Version="1.3.1" />
    <PackageReference Include="Google.Protobuf" Version="3.35.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/edge/PulseBoard.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Helpers.fs" />
    <Compile Include="IngestBenchmarks.fs" />
    <Compile Include="QueryBenchmarks.fs" />
    <Compile Include="AlertEvalBenchmarks.fs" />
    <Compile Include="NotifyQueueBenchmarks.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
